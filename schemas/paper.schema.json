{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paper_id",
    "title",
    "source_access"
  ],
  "properties": {
    "paper_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "venue": {
      "type": [
        "string",
        "null"
      ]
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "preprint_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "alternate_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "abstract": {
      "type": [
        "string",
        "null"
      ]
    },
    "version_inspected": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_access": {
      "enum": [
        "full_text",
        "abstract_only",
        "metadata_only",
        "inaccessible",
        "unverified"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "claim_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "citation_key": {
      "type": "string",
      "minLength": 1
    },
    "inclusion_reason": {
      "type": "string"
    },
    "source_eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "name",
        "rationale",
        "verification_url"
      ],
      "properties": {
        "criterion": {
          "enum": [
            "conference",
            "journal",
            "team",
            "university",
            "company",
            "substantive_preprint"
          ]
        },
        "name": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "verification_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "pdf_path": {
      "type": [
        "string",
        "null"
      ],
      "description": "Path relative to the paper index."
    },
    "pdf_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "pdf_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "download_status": {
      "enum": [
        "saved",
        "not_selected",
        "unavailable",
        "failed"
      ]
    },
    "note_path": {
      "type": [
        "string",
        "null"
      ],
      "description": "Path to the reading note relative to the paper index."
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
