{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchProject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "title",
    "domain",
    "status",
    "version"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string"
    },
    "research_question": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "object"
    },
    "constraints": {
      "type": [
        "array",
        "object",
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "completed",
        "archived"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
